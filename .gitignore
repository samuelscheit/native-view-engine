# Build artifacts
/target
/build
/cxx/build
/cxx/build-fabric
hosts/*/build/
hosts/swiftui-kit/.build/
hosts/flutter-plugin/.dart_tool/
hosts/flutter-plugin/pubspec.lock
packages/modules/native-views/flutter/.dart_tool/
packages/modules/native-views/flutter/pubspec.lock
packages/modules/native-views/flutter/build/
packages/modules/*/android/.gradle/
packages/modules/*/android/build/
**/*.o
**/*.a
**/*.dylib
**/*.so
**/*.xcframework
**/*.profraw

# IDE & OS
.DS_Store
.vscode/
.idea/
*.swp

# Prebuilt caches & local traces
/.nve-cache
*.perfetto.json
*.trace.json

# Generated ABI & Wire codec bindings (regenerated via `cargo run --locked -p nve-cli -- codegen abi`)
*.generated.*
**/generated/*.java
hosts/android-shell/android-app/src/dev/nve/android/generated/

# Mobile & desktop shells
hosts/ios-shell/Pods/
hosts/ios-shell/*.xcworkspace
hosts/android-shell/.gradle/
hosts/android-shell/build-host/
hosts/android-shell/local.properties
hosts/compose-kit/.gradle/
hosts/compose-kit/build/

# JVM / OpenJ9 crash dumps
core.*.dmp
javacore.*.txt
Snap.*.trc
hs_err_pid*.log

{
  "name": "@nve/camera",
  "version": "0.1.0",
  "description": "Optional React Native VisionCamera v5 adapter and typed CameraPreview binary codec (NVNP/NVNC/NVCF) for NVE.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wire": {
      "types": "./src/nve_camera_wire.ts",
      "import": "./src/nve_camera_wire.ts",
      "default": "./src/nve_camera_wire.ts"
    }
  },
  "files": [
    "src",
    "cxx/include",
    "cxx/CMakeLists.txt",
    "NveCamera.podspec",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-vision-camera": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-vision-camera": {
      "optional": true
    }
  },
  "nitro": {
    "cxxNamespace": [
      "nve",
      "camera"
    ],
    "hybridObjects": {
      "CameraSession": {
        "cxxHeader": "nve_vision_camera_hybrid.hpp",
        "jsiBridgeHeader": "nve_rn_camera_jsi.hpp"
      }
    }
  }
}

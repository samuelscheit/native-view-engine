{
  "name": "@nve/camera",
  "version": "0.1.0",
  "description": "Zero-JSON cross-platform camera module for React Native, React Native Windows (0.88), React Native macOS, React Native Web, and NVE.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "browser": "../web/src/nve_web_camera.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "../web/src/nve_web_camera.ts",
      "import": "../web/src/nve_web_camera.ts",
      "default": "../web/src/nve_web_camera.ts"
    },
    "./wire": {
      "types": "../web/src/nve_camera_wire.ts",
      "import": "../web/src/nve_camera_wire.ts",
      "default": "../web/src/nve_camera_wire.ts"
    }
  },
  "files": [
    "src",
    "cxx/include",
    "cxx/CMakeLists.txt",
    "windows/CMakeLists.txt",
    "NveCamera.podspec",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-macos": ">=0.76.0",
    "react-native-windows": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-macos": {
      "optional": true
    },
    "react-native-windows": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "NveCameraSpec",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "dev.nve.camera"
    },
    "ios": {
      "componentsProvider": {
        "NveCameraPreview": "NveAppleCameraView"
      }
    }
  },
  "nitro": {
    "cxxNamespace": [
      "nve",
      "camera"
    ],
    "hybridObjects": {
      "CameraSession": {
        "cxxHeader": "nve_vision_camera_hybrid.hpp",
        "jsiBridgeHeader": "nve_rn_camera_jsi.hpp"
      }
    }
  }
}

(module
  (import "d" "h" (func $html (param i32 i32)))
  (import "d" "t" (func $text (param i32 i32)))
  (memory (export "m") 1)
  (data (i32.const 64) "<style>i{display:flex;flex-direction:column;box-sizing:border-box}b{font:16px sans-serif}</style><i style=\"width:100%;height:100%;padding:24px;gap:16px;background:#0f172a\"><i style=\"padding:20px;gap:8px;background:#1e293b;border-radius:16px\"><b style=\"color:#38bdf8;font-size:14px\">NATIVE VIEW ENGINE</b><b style=\"color:#fff;font-size:28px\">Count: <u>0</u></b></i><i style=\"flex-direction:row;gap:12px\"><i data-e=1 style=\"width:160px;height:48px;justify-content:center;align-items:center;background:#2563eb;border-radius:12px\"><b style=\"color:#fff\">Increment +</b></i><i data-e=2 style=\"width:120px;height:48px;justify-content:center;align-items:center;background:#334155;border-radius:12px\"><b style=\"color:#e2e8f0\">Reset</b></i></i></i>")
  (global $n (mut i32) (i32.const 0))
  ;; write |n| as decimal ending at offset 16, call text(ptr,len)
  (func $show (local $p i32) (local $v i32) (local $neg i32)
    (local.set $p (i32.const 16))
    (local.set $v (global.get $n))
    (if (i32.lt_s (local.get $v) (i32.const 0))
      (then (local.set $neg (i32.const 1)) (local.set $v (i32.sub (i32.const 0) (local.get $v)))))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $v) (i32.const 10))))
      (br_if $l (local.tee $v (i32.div_u (local.get $v) (i32.const 10)))))
    (if (local.get $neg) (then
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.const 45))))
    (call $text (local.get $p) (i32.sub (i32.const 16) (local.get $p))))
  (func (export "s") (call $html (i32.const 64) (i32.const 738)))
  (func (export "e") (param $id i32)
    (global.set $n (select (i32.add (global.get $n) (i32.const 1)) (i32.const 0) (i32.eq (local.get $id) (i32.const 1))))
    (call $show)))
